{
  "name": "bullion-pulse-react",
  "version": "60.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4174",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test:frontend": "vitest run",
    "test:backend": "node monitor/test_monitor.mjs && node monitor/test_outlook.mjs",
    "test": "npm run typecheck && npm run test:frontend && npm run test:backend"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.8",
    "vitest": "^3.0.9"
  }
}
